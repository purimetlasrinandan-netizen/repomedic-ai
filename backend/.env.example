# RepoMedic AI Backend Configuration

# GitHub Access Token (Optional: Unauthenticated rate limit is 60 req/hr, with token is 5000 req/hr)
GITHUB_TOKEN=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=all-minilm

# Repository Analysis Safety Limits
MAX_REPOSITORY_FILES=500
MAX_FILE_SIZE_KB=500
MAX_TOTAL_CONTENT_MB=20
REQUEST_TIMEOUT_SECONDS=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./repomedic.db

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
